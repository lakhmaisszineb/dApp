# ============================================================
# .env.example : `cp .env.example .env`
# Le fichier .env est dans .gitignore 
# ============================================================

# --- Déploiement Sepolia -------------------------------
# URL RPC Sepolia 
SEPOLIA_RPC_URL=
# Clé privée d'un portefeuille DÉDIÉ AU TEST 
# Format : 64 caractères hexadécimaux avec préfixe 0x.
# Alternative plus sûre : `npx hardhat keystore set DEPLOYER_PRIVATE_KEY` (stockage chiffré).
DEPLOYER_PRIVATE_KEY=


# --- IPFS / Pinata : upload des métadonnées de campagne ---
# JWT Pinata avec permission minimale (pinning uniquement). Utilisé par les scripts, pas par le navigateur.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
